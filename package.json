{
  "name": "dsh-live-wallpaper",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Live wallpaper for DeepSeek Harness (web mode): GIF/MP4 walls, startup clips, seasons particles, gyro parallax, stickers and audio-reactive glow.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "author": "dsh-live-wallpaper contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOURNAME/dsh-live-wallpaper.git"
  },
  "bugs": {
    "url": "https://github.com/YOURNAME/dsh-live-wallpaper/issues"
  },
  "homepage": "https://github.com/YOURNAME/dsh-live-wallpaper#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "wallpaper",
    "live-wallpaper",
    "particles",
    "webgl",
    "anime"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/render.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}